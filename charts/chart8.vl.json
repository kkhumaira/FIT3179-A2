{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": {
    "text": "Different Places, Different Screens",
    "subtitle": [
      "Click Metro or Regional to explore all media. Click a media type to compare both groups.",
      "Map and bar clicks highlight a whole national group. All / All media reset the controls."
    ],
    "anchor": "start",
    "fontSize": 21
  },
  "params": [
    {
      "name": "chosenGroup",
      "views": [
        "groupButtons",
        "mapView",
        "barMarks"
      ],
      "select": {
        "type": "point",
        "fields": [
          "location_group"
        ],
        "on": "click[event.item && event.item.datum && isValid(event.item.datum.location_group)]",
        "toggle": false,
        "clear": false
      },
      "value": [
        {
          "location_group": "All"
        }
      ]
    },
    {
      "name": "chosenMedia",
      "views": [
        "mediaButtons"
      ],
      "select": {
        "type": "point",
        "fields": [
          "media_type"
        ],
        "toggle": false,
        "clear": false
      },
      "value": [
        {
          "media_type": "All media"
        }
      ]
    }
  ],
  "vconcat": [
    {
      "name": "groupButtons",
      "width": 400,
      "height": 35,
      "data": {
        "values": [
          {
            "location_group": "All"
          },
          {
            "location_group": "Metro"
          },
          {
            "location_group": "Regional"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "location_group",
          "type": "ordinal",
          "sort": [
            "All",
            "Metro",
            "Regional"
          ],
          "axis": null
        },
        "text": {
          "field": "location_group"
        },
        "color": {
          "condition": {
            "param": "chosenGroup",
            "empty": false,
            "value": "#0072B2"
          },
          "value": "#666666"
        }
      }
    },
    {
      "name": "mediaButtons",
      "width": 1000,
      "height": 35,
      "data": {
        "values": [
          {
            "media_type": "All media"
          },
          {
            "media_type": "Broadcast TV"
          },
          {
            "media_type": "Streaming services"
          },
          {
            "media_type": "YouTube"
          },
          {
            "media_type": "Social media video"
          },
          {
            "media_type": "Broadcast TV + on-demand"
          },
          {
            "media_type": "AM/FM radio"
          },
          {
            "media_type": "Online audio"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "media_type",
          "type": "ordinal",
          "sort": [
            "All media",
            "Broadcast TV",
            "Streaming services",
            "YouTube",
            "Social media video",
            "Broadcast TV + on-demand",
            "AM/FM radio",
            "Online audio"
          ],
          "axis": null
        },
        "text": {
          "field": "media_type"
        },
        "color": {
          "condition": {
            "param": "chosenMedia",
            "empty": false,
            "value": "#0072B2"
          },
          "value": "#666666"
        }
      }
    },
    {
      "hconcat": [
        {
          "name": "mapView",
          "width": 440,
          "height": 340,
          "data": {
            "url": "https://raw.githubusercontent.com/kkhumaira/FIT3179-A2/main/data/australia_metro_regional_fixed.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "transform": [
            {
              "calculate": "indexof(datum.properties.gccsa_code_2021, 'G') == 1 || datum.properties.gccsa_code_2021 == '8ACTE' ? 'Metro' : 'Regional'",
              "as": "location_group"
            }
          ],
          "projection": {
            "type": "mercator"          },
          "mark": {
            "type": "geoshape",
            "stroke": "white",
            "strokeWidth": 0.7,
            "cursor": "pointer"
          },
          "encoding": {
            "color": {
              "field": "location_group",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Metro",
                  "Regional"
                ],
                "range": [
                  "#E69F00",
                  "#0072B2"
                ]
              },
              "legend": {
                "title": null,
                "orient": "bottom"
              }
            },
            "opacity": {
              "condition": {
                "test": "!chosenGroup.location_group || chosenGroup.location_group[0] == 'All' || datum.location_group == chosenGroup.location_group[0]",
                "value": 1
              },
              "value": 0.25
            },
            "tooltip": [
              {
                "field": "location_group",
                "title": "National group"
              }
            ]
          }
        },
        {
          "width": 380,
          "height": 340,
          "title": {
            "text": {
              "expr": "chosenMedia.media_type && chosenMedia.media_type[0] != 'All media' ? chosenMedia.media_type[0] + ': Metro vs Regional' : (chosenGroup.location_group && chosenGroup.location_group[0] != 'All' ? chosenGroup.location_group[0] + ': all media' : 'Media use: Metro vs Regional')"
            },
            "fontSize": 15,
            "anchor": "start"
          },
          "data": {
            "values": [
              {
                "year": 2024,
                "media_type": "Broadcast TV",
                "location_group": "Metro",
                "percentage": 51.0
              },
              {
                "year": 2024,
                "media_type": "Broadcast TV",
                "location_group": "Regional",
                "percentage": 66.0
              },
              {
                "year": 2025,
                "media_type": "Broadcast TV",
                "location_group": "Metro",
                "percentage": 50.0
              },
              {
                "year": 2025,
                "media_type": "Broadcast TV",
                "location_group": "Regional",
                "percentage": 67.0
              },
              {
                "year": 2025,
                "media_type": "Streaming services",
                "location_group": "Metro",
                "percentage": 80.0
              },
              {
                "year": 2025,
                "media_type": "Streaming services",
                "location_group": "Regional",
                "percentage": 70.0
              },
              {
                "year": 2025,
                "media_type": "YouTube",
                "location_group": "Metro",
                "percentage": 82.0
              },
              {
                "year": 2025,
                "media_type": "YouTube",
                "location_group": "Regional",
                "percentage": 66.0
              },
              {
                "year": 2025,
                "media_type": "Social media video",
                "location_group": "Metro",
                "percentage": 83.0
              },
              {
                "year": 2025,
                "media_type": "Social media video",
                "location_group": "Regional",
                "percentage": 72.0
              },
              {
                "year": 2025,
                "media_type": "Broadcast TV + on-demand",
                "location_group": "Metro",
                "percentage": 72.0
              },
              {
                "year": 2025,
                "media_type": "Broadcast TV + on-demand",
                "location_group": "Regional",
                "percentage": 85.0
              },
              {
                "year": 2025,
                "media_type": "AM/FM radio",
                "location_group": "Metro",
                "percentage": 48.0
              },
              {
                "year": 2025,
                "media_type": "AM/FM radio",
                "location_group": "Regional",
                "percentage": 61.0
              },
              {
                "year": 2025,
                "media_type": "Online audio",
                "location_group": "Metro",
                "percentage": 72.0
              },
              {
                "year": 2025,
                "media_type": "Online audio",
                "location_group": "Regional",
                "percentage": 57.0
              }
            ]
          },
          "transform": [
            {
              "filter": "datum.year == 2025"
            },
            {
              "filter": "(chosenMedia.media_type && chosenMedia.media_type[0] != 'All media') ? datum.media_type == chosenMedia.media_type[0] : (!(chosenGroup.location_group && chosenGroup.location_group[0] != 'All') || datum.location_group == chosenGroup.location_group[0])"
            },
            {
              "calculate": "(chosenMedia.media_type && chosenMedia.media_type[0] != 'All media') ? datum.location_group : datum.media_type",
              "as": "category"
            },
            {
              "calculate": "format(datum.percentage,'.0f') + '%'",
              "as": "label"
            }
          ],
          "encoding": {
            "y": {
              "field": "category",
              "type": "nominal",
              "sort": [
                "Broadcast TV",
                "Streaming services",
                "YouTube",
                "Social media video",
                "Broadcast TV + on-demand",
                "AM/FM radio",
                "Online audio"
              ],
              "axis": {
                "title": null,
                "labelLimit": 190
              }
            },
            "yOffset": {
              "field": "location_group",
              "sort": [
                "Metro",
                "Regional"
              ]
            },
            "x": {
              "field": "percentage",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  100
                ]
              },
              "axis": {
                "title": "Reported use (%)"
              }
            },
            "opacity": {
              "condition": {
                "test": "!chosenGroup.location_group || chosenGroup.location_group[0] == 'All' || datum.location_group == chosenGroup.location_group[0]",
                "value": 1
              },
              "value": 0.25
            }
          },
          "layer": [
            {
              "mark": {
                "type": "bar",
                "cursor": "pointer",
                "cornerRadiusEnd": 3
              },
              "encoding": {
                "color": {
                  "field": "location_group",
                  "type": "nominal",
                  "scale": {
                    "domain": [
                      "Metro",
                      "Regional"
                    ],
                    "range": [
                      "#E69F00",
                      "#0072B2"
                    ]
                  },
                  "legend": null
                },
                "tooltip": [
                  {
                    "field": "location_group",
                    "title": "National group"
                  },
                  {
                    "field": "media_type",
                    "title": "Media"
                  },
                  {
                    "field": "percentage",
                    "title": "Reported use (%)"
                  }
                ]
              },
              "name": "barMarks"
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "dx": 4,
                "fontSize": 11
              },
              "encoding": {
                "text": {
                  "field": "label"
                }
              }
            }
          ]
        }
      ],
      "spacing": 30
    }
  ],
  "spacing": 18,
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E8E8E8",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "subtitleFontSize": 12,
      "subtitlePadding": 8
    },
    "concat": {
      "spacing": 25
    }
  }
}