{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": {
    "text": "Where Does Digital Inclusion Fall Behind?",
    "subtitle": [
      "State and territory differences from the national average, 2024",
      "Circle size shows the gap in index points. Click a circle to explore."
    ],
    "anchor": "start",
    "offset": 20
  },
  "params": [
    {
      "name": "belowOnly",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Show below-average states only: "
      }
    }
  ],
  "vconcat": [
    {
      "width": 700,
      "height": 350,
      "projection": {
        "type": "mercator",
        "rotate": [-134, 0, 0]
      },
      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/alwaysblazing/Australia-State-TopoJson-MapChart/master/au-states-topo.json",
            "format": {
              "type": "topojson",
              "feature": "austates"
            }
          },
          "transform": [
            {
              "filter": "datum.id < 8"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#F1F1EE",
            "stroke": "#AAAAAA",
            "strokeWidth": 0.8
          }
        },
        {
          "data": {
            "url": "https://raw.githubusercontent.com/kkhumaira/FIT3179-A2/main/data/digital_inclusion_by_state.csv",
            "format": {
              "type": "csv",
              "parse": {
                "adii_score": "number",
                "national_average": "number",
                "gap": "number",
                "longitude": "number",
                "latitude": "number"
              }
            }
          },
          "transform": [
            {
              "calculate": "abs(datum.gap)",
              "as": "absolute_gap"
            },
            {
              "calculate": "datum.gap < 0 ? 'Below national average' : 'Above national average'",
              "as": "comparison"
            },
            {
              "filter": "!belowOnly || datum.gap < 0"
            }
          ],
          "params": [
            {
              "name": "selectedState",
              "select": {
                "type": "point",
                "fields": ["state"],
                "toggle": false,
                "clear": "dblclick"
              }
            }
          ],
          "mark": {
            "type": "circle",
            "stroke": "#FFFFFF",
            "strokeWidth": 1.5,
            "cursor": "pointer"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "absolute_gap",
              "type": "quantitative",
              "scale": {
                "domain": [0, 7],
                "range": [0, 2200]
              },
              "legend": {
                "title": "Gap size (index points)",
                "orient": "bottom",
                "values": [1, 3, 6]
              }
            },
            "color": {
              "field": "comparison",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Below national average",
                  "Above national average"
                ],
                "range": ["#D55E00", "#0072B2"]
              },
              "legend": {
                "title": null,
                "orient": "bottom"
              }
            },
            "opacity": {
              "condition": {
                "param": "selectedState",
                "value": 1
              },
              "value": 0.25
            },
            "tooltip": [
              {
                "field": "state",
                "title": "State / territory"
              },
              {
                "field": "adii_score",
                "type": "quantitative",
                "title": "Digital inclusion score",
                "format": ".1f"
              },
              {
                "field": "national_average",
                "type": "quantitative",
                "title": "National average",
                "format": ".1f"
              },
              {
                "field": "gap",
                "type": "quantitative",
                "title": "Difference (index points)",
                "format": "+.1f"
              }
            ]
          }
        }
      ]
    },
    {
      "width": 700,
      "height": 45,
      "data": {
        "url": "https://raw.githubusercontent.com/kkhumaira/FIT3179-A2/main/data/digital_inclusion_by_state.csv",
        "format": {
          "type": "csv",
          "parse": {
            "adii_score": "number",
            "gap": "number"
          }
        }
      },
      "transform": [
        {
          "filter": {
            "param": "selectedState",
            "empty": false
          }
        },
        {
          "filter": "!belowOnly || datum.gap < 0"
        },
        {
          "calculate": "datum.state + ': ' + format(datum.adii_score, '.1f') + ' — ' + format(abs(datum.gap), '.1f') + ' points ' + (datum.gap < 0 ? 'below' : 'above') + ' the national average'",
          "as": "detail"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#253248"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 20
        },
        "text": {
          "field": "detail"
        }
      }
    }
  ],
  "spacing": 15,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 21,
      "subtitleFontSize": 12,
      "subtitlePadding": 8,
      "color": "#253248"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "padding": 10
    }
  }
}