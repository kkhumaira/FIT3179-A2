{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": {
    "text": "Where Does Digital Inclusion Fall Behind?",
    "subtitle": [
      "State and territory differences from the national average, 2024 survey wave",
      "Circle area represents the absolute gap in index points. Click a circle or bar; double-click to reset."
    ],
    "anchor": "start",
    "fontSize": 21
  },
  "params": [
    {
      "name": "belowOnly",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Below average only: "
      }
    },
    {
      "name": "selectedState",
      "views": [
        "symbolMarks",
        "rankedBars"
      ],
      "select": {
        "type": "point",
        "fields": [
          "state"
        ],
        "toggle": false,
        "clear": "dblclick"
      }
    }
  ],
  "hconcat": [
    {
      "width": 500,
      "height": 390,
      "projection": {
        "type": "equalEarth",
        "rotate": [
          -134,
          0,
          0
        ]
      },
      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/alwaysblazing/Australia-State-TopoJson-MapChart/master/au-states-topo.json",
            "format": {
              "type": "topojson",
              "feature": "austates"
            }
          },
          "transform": [
            {
              "filter": "datum.id < 8"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#F1F1EE",
            "stroke": "#AAAAAA",
            "strokeWidth": 0.7
          }
        },
        {
          "name": "symbolMarks",
          "data": {
            "url": "https://raw.githubusercontent.com/kkhumaira/FIT3179-A2/main/data/digital_inclusion_by_state.csv",
            "format": {
              "type": "csv",
              "parse": {
                "year": "number",
                "adii_score": "number",
                "national_average": "number",
                "gap": "number",
                "longitude": "number",
                "latitude": "number"
              }
            }
          },
          "transform": [
            {
              "calculate": "datum.gap < 0 ? 'Below national average' : 'Above national average'",
              "as": "comparison"
            },
            {
              "calculate": "abs(datum.gap)",
              "as": "absolute_gap"
            },
            {
              "filter": "!belowOnly || datum.gap < 0"
            }
          ],
          "mark": {
            "type": "circle",
            "stroke": "white",
            "strokeWidth": 1.5,
            "cursor": "pointer"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "absolute_gap",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  7
                ],
                "range": [
                  0,
                  1800
                ]
              },
              "legend": {
                "title": "Absolute gap (points)",
                "orient": "bottom",
                "values": [
                  1,
                  3,
                  6
                ]
              }
            },
            "color": {
              "field": "comparison",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Below national average",
                  "Above national average"
                ],
                "range": [
                  "#D55E00",
                  "#0072B2"
                ]
              },
              "legend": {
                "title": null,
                "orient": "bottom"
              }
            },
            "opacity": {
              "condition": {
                "param": "selectedState",
                "value": 1
              },
              "value": 0.25
            },
            "tooltip": [
              {
                "field": "state",
                "title": "State / territory"
              },
              {
                "field": "adii_score",
                "type": "quantitative",
                "title": "ADII score",
                "format": ".1f"
              },
              {
                "field": "national_average",
                "type": "quantitative",
                "title": "National average",
                "format": ".1f"
              },
              {
                "field": "gap",
                "type": "quantitative",
                "title": "Difference (index points)",
                "format": "+.1f"
              }
            ]
          }
        }
      ]
    },
    {
      "width": 320,
      "height": 350,
      "title": {
        "text": "Digital inclusion scores",
        "subtitle": "Dashed line: national average (73.6)",
        "anchor": "start",
        "fontSize": 15
      },
      "layer": [
        {
          "name": "rankedBars",
          "data": {
            "url": "https://raw.githubusercontent.com/kkhumaira/FIT3179-A2/main/data/digital_inclusion_by_state.csv",
            "format": {
              "type": "csv",
              "parse": {
                "year": "number",
                "adii_score": "number",
                "national_average": "number",
                "gap": "number",
                "longitude": "number",
                "latitude": "number"
              }
            }
          },
          "transform": [
            {
              "calculate": "datum.gap < 0 ? 'Below national average' : 'Above national average'",
              "as": "comparison"
            },
            {
              "calculate": "abs(datum.gap)",
              "as": "absolute_gap"
            },
            {
              "filter": "!belowOnly || datum.gap < 0"
            }
          ],
          "mark": {
            "type": "bar",
            "cursor": "pointer",
            "cornerRadiusEnd": 3
          },
          "encoding": {
            "y": {
              "field": "abbreviation",
              "type": "nominal",
              "sort": {
                "field": "adii_score",
                "order": "descending"
              },
              "title": null
            },
            "x": {
              "field": "adii_score",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  100
                ]
              },
              "title": "ADII score (0\u2013100)"
            },
            "color": {
              "field": "comparison",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Below national average",
                  "Above national average"
                ],
                "range": [
                  "#D55E00",
                  "#0072B2"
                ]
              },
              "legend": null
            },
            "opacity": {
              "condition": {
                "param": "selectedState",
                "value": 1
              },
              "value": 0.25
            },
            "tooltip": [
              {
                "field": "state",
                "title": "State / territory"
              },
              {
                "field": "adii_score",
                "type": "quantitative",
                "title": "ADII score",
                "format": ".1f"
              },
              {
                "field": "national_average",
                "type": "quantitative",
                "title": "National average",
                "format": ".1f"
              },
              {
                "field": "gap",
                "type": "quantitative",
                "title": "Difference (index points)",
                "format": "+.1f"
              }
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "average": 73.561329488673
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#333333",
            "strokeDash": [
              5,
              4
            ]
          },
          "encoding": {
            "x": {
              "field": "average",
              "type": "quantitative"
            }
          }
        }
      ]
    }
  ],
  "spacing": 30,
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E8E8E8",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "subtitleFontSize": 12,
      "subtitlePadding": 8
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}